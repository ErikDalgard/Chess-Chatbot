# Full features (puzzles + tool calling + board analysis) require the Vercel AI Gateway.
LLM_PROVIDER=gateway
LLM_MODEL=openai/gpt-5-mini
GATEWAY_API_KEY=your-api-key

# Optional: Gemini for streaming chat / image parse only (no puzzle tool calling yet).
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=your-api-key

DEVICE=cpu
